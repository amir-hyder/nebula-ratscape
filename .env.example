# NAVI environment variables. Copy to .env and fill in.
# .env is git-ignored. Never commit real values.

# OneMap account — free registration at https://www.onemap.gov.sg/apidocs/
# Used for public-transport routing, walking routes and geocoding.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# LTA DataMall AccountKey — free registration at https://datamall.lta.gov.sg
# Used for train service alerts, station crowd density and bus arrivals.
LTA_ACCOUNT_KEY=

# Port the local backend listens on. Default 8080.
PORT=8080
